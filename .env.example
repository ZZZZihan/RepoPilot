# Optional: required only for private repositories or higher GitHub API limits.
REPOPILOT_GITHUB_TOKEN=

# Local authoritative store for plans and approval transitions.
REPOPILOT_DATABASE_PATH=var/repopilot.db

# Bounded repository-inspection limits. Raising these increases memory and API use.
REPOPILOT_MAX_TREE_ENTRIES=2000
REPOPILOT_MAX_SELECTED_FILES=32
REPOPILOT_MAX_FILE_BYTES=65536
REPOPILOT_MAX_TOTAL_BYTES=393216
REPOPILOT_MAX_RESPONSE_BYTES=2097152
REPOPILOT_REQUEST_TIMEOUT_SECONDS=10
# Independent wall-clock deadline for the complete metadata/tree/blob inspection.
REPOPILOT_INSPECTION_TIMEOUT_SECONDS=30

# GitHub's versioned REST contract used by the adapter.
REPOPILOT_GITHUB_API_VERSION=2026-03-10
